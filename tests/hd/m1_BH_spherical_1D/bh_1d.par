&filelist
  base_filename = 'output/bh1d'
  typefilelog   = 'default'
  convert_type  = 'oneblock'
  level_io      = 1
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  dtsave_dat = 1d-2
  dtsave_log = 1d-2
  ditsave_dat = 10000
  ! ditsave_log = 1
/

&stoplist
  time_max = 1.d0 !1.60d-4
  it_max = 1000000
/

&methodlist
  time_stepper = 'twostep'
  time_integrator = 'IMEX_Midpoint'
  flux_scheme  = 'hll'
  limiter      = 'weno3'
  check_small_values = .True.
  fix_small_values = .True.
  small_values_method = 'replace'
/

&boundlist
  typeboundary_min1 = 4*'special'
  typeboundary_max1 = 4*'cont'
/

&meshlist
  domain_nx1         = 320
  block_nx1          = 80
  xprobmin1          = 1.0d0
  xprobmax1          = 10.0d0
  stretch_dim(1)     = 'uni'
  qstretch_baselevel = 1.015
/

&paramlist
  courantpar = 0.1d0
  !slowsteps = 1000
/

&hd_list
  hd_gravity = .true.
  hd_energy  = .false.
  hd_gamma   = 1.d0
  hd_m1 = .true.
/

&m1_list
  m1_opacity_type = 'kappa_e'
  m1_force = .true.
  m1_heatcool = .false.
  m1_RSOL = 1.d0
/

&star_list
  mstar    = 10.0d0
  rstar    = 10.0d0
  gammae   = 0.5d0
  rho_inf  = 1.d-18
  T_inf    = 1.d6
/
