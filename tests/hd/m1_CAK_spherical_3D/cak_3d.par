&filelist
  base_filename = 'output/cak3d'
  typefilelog   = 'default'
  convert_type  = 'vtuBCCmpi'
  autoconvert   = .true.
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  ! dtsave_dat = 1d-2
  ! dtsave_log = 1d-2
  ditsave_dat = 1
  ditsave_log = 1
/

&stoplist
  time_max = 1.d0 !1.60d-4
  it_max = 5 !000000
/

&methodlist
  time_stepper = 'twostep'
  time_integrator = 'IMEX_Midpoint'
  flux_scheme  = 'hll'
  limiter      = 'weno3'
  check_small_values = .True.
  fix_small_values = .True.
  small_values_method = 'replace'
  small_pressure = 1.d-5
/

&boundlist
  typeboundary_min1 = 9*'special'
  typeboundary_max1 = 9*'cont'
  typeboundary_min2 = 9*'cont'
  typeboundary_max2 = 9*'cont'
  typeboundary_min3 = 9*'cont'
  typeboundary_max3 = 9*'cont'
/

&meshlist
  domain_nx1         = 512
  domain_nx2         = 128
  domain_nx3         = 128
  block_nx1          = 8
  block_nx1          = 8
  block_nx1          = 8
  xprobmin1          = 1.0d0
  xprobmax1          = 10.0d0
  xprobmin2          = 0.15d0
  xprobmax2          = 0.35d0
  xprobmin3          = -0.1d0
  xprobmax3          = 0.1d0
  stretch_dim(1)     = 'uni'
  qstretch_baselevel = 1.015
/

&paramlist
  courantpar = 0.1d0
  ! slowsteps = 100
/

&hd_list
  hd_gravity = .true.
  hd_energy  = .true.
  hd_gamma   = 1.667d0
  hd_m1 = .true.
  m1_opacity_type = 'Gayley'
  m1_force = .true.
  m1_force_split = .true.
/

&star_list
  mstar    = 50.0d0
  rstar    = 20.0d0
  teff     = 4.0d4
  rhobound = 2.0d-11
  beta     = 0.5d0
/
