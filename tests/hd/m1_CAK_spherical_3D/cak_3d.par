&filelist
  base_filename = 'output/cak3d'
  typefilelog   = 'default'
  convert_type  = 'vtuBCCmpi'
  autoconvert   = .true.
  level_io      = 1
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  dtsave_dat = 1.d-2
  dtsave_log = 1.d-2
  ! ditsave_dat = 10
  ! ditsave_log = 1000
/

&stoplist
  time_max = 0.5d0
  ! it_max = 100
/

&methodlist
  time_stepper = 'onestep'
  time_integrator = 'IMEX_Euler'
  flux_scheme  = 'tvdlf'
  limiter      = 'weno3'
  check_small_values = .True.
  fix_small_values = .True.
  small_values_method = 'replace'
  small_pressure = 1.d-8
/

&boundlist
  typeboundary_min1 = 9*'special'
  typeboundary_max1 = 'noinflow','special','noinflow','noinflow','noinflow','noinflow','special','noinflow','noinflow'
  typeboundary_min2 = 'symm','symm','asymm','symm','symm','symm','symm','asymm','symm'
  typeboundary_max2 = 'symm','symm','asymm','symm','symm','symm','symm','asymm','symm'
  typeboundary_min3 = 'symm','symm','symm','asymm','symm','symm','symm','symm','asymm'
  typeboundary_max3 = 'symm','symm','symm','asymm','symm','symm','symm','symm','asymm'
  internalboundary = .true.
  /

&meshlist
  domain_nx1         = 320
  domain_nx2         = 16
  domain_nx3         = 16
  block_nx1          = 40
  block_nx2          = 8
  block_nx3          = 8
  xprobmin1          = 1.0d0
  xprobmax1          = 10.0d0
  xprobmin2          = 0.23d0
  xprobmax2          =  0.27d0
  xprobmin3          = 0.d0
  xprobmax3          =  0.02d0
  stretch_dim(1)     = 'uni'
  !qstretch_baselevel = 1.015
/

&paramlist
  courantpar = 0.4d0
/

&hd_list
  hd_gravity = .true.
  hd_energy  = .true.
  hd_gamma   = 1.667d0
  hd_m1 = .true.
  m1_opacity_type = 'Gayley'
  m1_heatcool = .true.
  m1_force = .true.
  m1_RSOL = 1.d-2
  m1_theta_stiff = 0.96d0
/

&star_list
  mstar    = 50.0d0
  rstar    = 20.0d0
  teff     = 4.0d4
  rhobound = 2.0d-12
  fred_bound = 0.2d0
  beta     = 0.5d0
/
