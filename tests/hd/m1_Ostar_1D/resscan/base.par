! 1D radial resolution scan for Star8, with the numerics of the 2D run
! (tests/hd/m1_Ostar_2D/parfiles_hpc/parfiles/base.par + Star8.par), except the
! time integrator: IMEX_Midpoint leaves the stiff flux absorption undamped
! (amplification factor -> -1), which gives grid-scale noise in F in the deep
! zone; IMEX_CB3a (L-stable implicit part) does not.
! The resolution is set per run in nXXXX.par (domain_nx1, base_filename).
! Run from tests/hd/m1_Ostar_1D:  ./amrvac -i resscan/base.par resscan/n0640.par

&filelist
  base_filename = 'resscan/'
  typefilelog   = 'default'
  convert_type  = 'oneblock'
  level_io      = 1
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  dtsave_dat = 1.d-2
  dtsave_log = 1.d-3
/

&stoplist
  time_max = 1.d0
/

&methodlist
  time_stepper = 'threestep'
  time_integrator = 'IMEX_CB3a'
  flux_scheme  = 'tvdlf'
  limiter      = 'ppm'
  check_small_values = .true.
  fix_small_values = .true.
  small_values_method = 'replace'
  small_pressure = 1.d-14
  small_density = 1.d-12
/

&boundlist
  typeboundary_min1 = 5*'special'
  typeboundary_max1 = 'noinflow','special','noinflow','noinflow','special'
  internalboundary = .false.
/

&meshlist
  refine_max_level   = 1
  block_nx1          = 40
  xprobmin1          = 1.0d0
  xprobmax1          = 5.0d0
  stretch_dim(1)     = 'uni'
/

&paramlist
  courantpar = 0.7d0
/

&hd_list
  hd_gravity = .true.
  hd_energy  = .true.
  hd_gamma   = 1.667d0
  hd_m1 = .true.
/

&m1_list
  m1_opacity_type = 'hybrid2'
  m1_heatcool = .true.
  m1_force = .true.
  m1_RSOL = 1.d0
/

&star_list
  mstar    = 21.0d0
  rstar    = 11.0d0
  Tbound   = 5.0d5
  gamma_e  = 0.17d0
  rhobound = 3.8e-6
  beta     = 0.5d0
  ic_file  = 'Star8_init.txt'
  len_ic   = 3070
  fixed_lum = .true.
  r_damp   = 1.10d0
  tau_damp = 5.d-3
/
