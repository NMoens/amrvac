&filelist
  base_filename = 'output/'
  typefilelog   = 'default'
  convert_type  = 'vtuBCCmpi'
  autoconvert   = .true.
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  !dtsave_dat = 1.d-2
  !dtsave_log = 1.d-2
  ditsave_dat = 10
  ditsave_log = 10
/

&stoplist
  time_max = 10.d0
  it_max = 30000
/

&methodlist
  time_stepper = 'twostep'
  time_integrator = 'IMEX_Midpoint'
  flux_scheme  = 'tvdlf'
  limiter      = 'weno3'
  check_small_values = .True.
  fix_small_values = .True.
  small_values_method = 'replace'
  small_pressure = 1.d-12
  small_density = 1.d-12
/

&boundlist
  typeboundary_min1 = 9*'special'
  typeboundary_max1 = 9*'noinflow'
  typeboundary_min2 = 'symm','symm','asymm','asymm','symm','symm','symm','asymm','asymm'
  typeboundary_max2 = 'symm','symm','asymm','symm','symm','symm','symm','asymm','symm'
  internalboundary = .false.
/

&meshlist
  refine_max_level   = 3
  domain_nx1         = 320
  domain_nx2         = 160
  block_nx1          = 20
  block_nx2          = 20
  xprobmin1          = 1.0d0
  xprobmax1          = 5.0d0
  xprobmin2          = 0.d0
  xprobmax2          =  0.25d0
  stretch_dim(1)     = 'uni'
  !qstretch_baselevel = 1.015
/

&paramlist
  courantpar = 0.4d0
/

&hd_list
  hd_gravity = .true.
  hd_energy  = .true.
  hd_gamma   = 1.667d0
  hd_m1 = .true.
  m1_opacity_type = 'hybrid2'
  m1_heatcool = .true.
  m1_force = .true.
  m1_RSOL = 1.d-1
/
