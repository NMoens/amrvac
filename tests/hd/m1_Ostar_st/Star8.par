&filelist
  base_filename = 'output/Star8_1d'
  typefilelog   = 'default'
  convert_type  = 'oneblock'
  level_io      = 1
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  dtsave_dat = 1.d-1
  dtsave_log = 1.d-2
  !ditsave_dat = 1
  !ditsave_log = 100
/

&stoplist
  time_max = 1.d1
  !reset_it = T
  !it_max = 1 !500
/

&methodlist
  time_stepper = 'onestep'
  time_integrator = 'IMEX_Euler'
  flux_scheme  = 'tvdlf' !'tvdlf'
  limiter      = 'minmod' !'ppm'
  typegrad     = 'limited'
  gradient_limiter = 'minmod'
  check_small_values = .True.
  fix_small_values = .True.
  small_values_method = 'replace'
  small_density = 1.d-14
  small_pressure = 1.d-18
/

&boundlist
  typeboundary_min1 = 5*'special'
  typeboundary_max1 = 'noinflow','special','noinflow','noinflow','special'
  internalboundary = .true.
/

&meshlist
  refine_max_level   = 1
  domain_nx1         = 128
  block_nx1          = 32
  xprobmin1          = 1.0d0
  xprobmax1          = 1.25d0
  stretch_dim(1)     = 'uni'
  !qstretch_baselevel = 1.015
/

&paramlist
  courantpar = 0.5d0
/

&hd_list
  hd_gravity = .true.
  hd_energy  = .true.
  hd_gamma   = 1.667d0
  hd_m1 = .true.
/

&m1_list
  m1_opacity_type = 'hybrid1'
  m1_heatcool = .false.
  m1_force = .false.
  m1_RSOL = 1.d0
  m1_diffusion = .true.
/

&star_list
  mstar    = 21.0d0
  rstar    = 11.0d0
  Tbound   = 5.0d5
  gamma_e  = 0.17d0
  rhobound = 3.8e-6
  beta     = 0.5d0
  ic_file  = 'Star8_init.txt'
  fixed_lum = .True.
/
