&filelist
  base_filename = 'chk/Riemann1_'
  typefilelog   = 'default'
  convert_type  = 'oneblock'
  level_io      = 1
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  dtsave_dat = 1d0
  dtsave_log = 1d0
  !ditsave_dat = 1
  !ditsave_log = 1
/

&stoplist
  time_max = 20.d0
  !it_max = 10 !200
/

&methodlist
  time_stepper = 'onestep'
  time_integrator = 'Forward_Euler'
  flux_scheme  = 'hll'
  limiter      = 'weno3'
  fix_small_values = .true.
  small_values_method = 'replace'
  small_pressure = 1.d-6
/

&boundlist
  typeboundary_min1 = 6*'cont'
  typeboundary_max1 = 6*'cont'
/

&meshlist
  refine_max_level   = 1 
  refine_criterion   = 3
  domain_nx1         = 512
  block_nx1          = 16
  xprobmin1          = -20.d0
  xprobmax1          = 20.d0
  w_refine_weight(4) = 1.d0
/

&paramlist
  courantpar = 0.3d0
  !slowsteps = 100
/

&hd_list
  He_abundance    = 0.d0
  hd_energy       = .false.
  hd_gamma        = 1.667d0
  hd_m1           = .true.
/

&m1_list
  m1_opacity_type = 'zero'
  m1_force        = .false.
  m1_heatcool     = .false
  m1_RSOL         = 1.d0
/

&shock_list
  Er_l = 1.d0
  Fx_l = 0.d0
  Fy_l = 0.5d0
  Er_r = 1.d0
  Fx_r = 0.d0
  Fy_r = 0.d0
/
