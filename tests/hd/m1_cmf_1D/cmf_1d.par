&filelist
  base_filename = 'output/cmf1d'
  typefilelog   = 'default'
  convert_type  = 'oneblock'
  level_io      = 1
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  dtsave_dat = 1.d0
  dtsave_log = 1.d0
  ! ditsave_dat = 500
  ! ditsave_log = 100
/

&stoplist
  time_max = 10.d0
  !it_max = 5000
/

&methodlist
  time_stepper = 'onestep'
  !time_integrator = 'IMEX_Euler'
  flux_scheme  = 'tvdlf'
  limiter      = 'minmod'
  check_small_values = .True.
  fix_small_values = .True.
  small_values_method = 'replace'
/

&boundlist
  typeboundary_min1 = 4*'special'
  typeboundary_max1 = 4*'cont'
  internalboundary = .true.
/

&meshlist
  refine_max_level   = 1
  refine_criterion   = 3
  domain_nx1         = 256
  block_nx1          = 128
  xprobmin1          = 0.1d0
  xprobmax1          = 1.d0
/

&paramlist
  courantpar = 0.3d0
  slowsteps = 100
/

&hd_list
  He_abundance = 0.d0
  hd_energy  = .false.
  hd_gamma   = 1.d0
  hd_adiab = 0.d0
  hd_m1 = .true.
/

&m1_list
  m1_opacity_type = 'zero'
  m1_heatcool = .false.
  m1_force = .false.
  m1_split_opacities = .false.
/

&stream_list
  beta_max = 0.1d0
  F_red = 0.99d0
/
