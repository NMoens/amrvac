&filelist
  base_filename = 'output/supc_shock'
  typefilelog   = 'default'
  convert_type  = 'oneblock'
  level_io      = 1
  saveprim      = .true.
  nwauxio       = 0
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  dtsave_dat = 1d-2
  dtsave_log = 1d-2
  !ditsave_dat = 1000
  !ditsave_log = 1
/

&stoplist
  time_max = 1.d0
  !it_max = 200
/

&methodlist
  time_stepper = 'twostep'
  time_integrator = 'IMEX_Midpoint'
  flux_scheme  = 'tvdlf'
  limiter      = 'weno5'
  fix_small_values = .true.
  small_values_method = 'replace'
  small_pressure = 1.d-6
/

&boundlist
  typeboundary_min1 = 'symm','asymm','symm','symm','asymm'
  typeboundary_max1 = 5*'cont'
/

&meshlist
  refine_max_level   = 3
  refine_criterion   = 3
  domain_nx1         = 512
  block_nx1          = 16
  xprobmin1          = 0.d0
  xprobmax1          = 1.d0
/

&paramlist
  courantpar = 0.3d0
  !slowsteps = 100
/

&hd_list
  He_abundance    = 0.d0
  hd_energy       = .true.
  hd_gamma        = 1.4d0
  hd_m1           = .true.
/

&m1_list
  m1_opacity_type = 'kappa_e'
  m1_diffusion    = .false.
  m1_force        = .true.
  m1_RSOL         = 1.d-2
/

&shock_list
  rho1    = 7.78d-10
  v1      = 20.d5
  T1      = 10.d0
/
