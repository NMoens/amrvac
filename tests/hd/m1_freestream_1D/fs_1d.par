&filelist
  base_filename = 'output/fs1d'
  typefilelog   = 'default'
  convert_type  = 'oneblock'
  level_io      = 1
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  ! dtsave_dat = 1d-2
  dtsave_log = 1d-2
  ditsave_dat = 10
  ! ditsave_log = 100
/

&stoplist
  time_max = 1.d0
  it_max = 1000
/

&methodlist
  time_stepper = 'onestep'
  time_integrator = 'IMEX_Euler'
  flux_scheme  = 'tvdlf'
  limiter      = 'minmod'
/

&boundlist
  typeboundary_min1 = 4*'special'
  typeboundary_max1 = 4*'cont'
/

&meshlist
  refine_max_level   = 1
  refine_criterion   = 3
  domain_nx1         = 256
  block_nx1          = 128
  xprobmin1          = 0.d0
  xprobmax1          = 1.d0
/

&paramlist
  courantpar = 0.3d0
  slowsteps = 100
/

&hd_list
  He_abundance = 0.d0
  hd_energy  = .false.
  hd_gamma   = 1.d0
  hd_m1 = .true.
/

&m1_list  
  m1_opacity_type = 'kappa_e'
  m1_diffusion = .false.
  m1_force = .false.
/

&stream_list
  L = 1.d10
  rho = 1.d-15
  Er = 1000
  F_red = 1.d0
/
