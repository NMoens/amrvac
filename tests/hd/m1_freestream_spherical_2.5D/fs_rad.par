&filelist
  base_filename = 'output/fs_rad'
  typefilelog   = 'default'
  convert_type  = 'vtuBCCmpi'
  autoconvert   = .true.
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  ! dtsave_dat = 1d-2
  dtsave_log = 1d-2
  ditsave_dat = 50
  ! ditsave_log = 100
/

&stoplist
  time_max = 1.d0
  it_max = 5000
/

&methodlist
  time_stepper = 'onestep'
  ! time_integrator = 'IMEX_Euler'
  flux_scheme  = 'tvdlf'
  limiter      = 'minmod'
/

&boundlist
  typeboundary_min1 = 4*'cont','special','special',2*'cont'
  typeboundary_max1 = 8*'cont'
  typeboundary_min2 = 8*'cont'
  typeboundary_max2 = 8*'cont'
/

&meshlist
  iprob		     = 1
  refine_max_level   = 1
  refine_criterion   = 3
  domain_nx1         = 256
  block_nx1          = 16
  domain_nx2         = 256
  block_nx2          = 16
  xprobmin1          = 1.d0
  xprobmax1          = 5.d0
  xprobmin2          = 0.d0
  xprobmax2          = 0.25d0
/

&paramlist
  courantpar = 0.3d0
  slowsteps = 100
/

&hd_list
  He_abundance = 0.d0
  hd_energy  = .false.
  hd_gamma   = 1.d0
  hd_m1 = .true.
/

&m1_list
  m1_opacity_type = 'kappa_e'
  m1_diffusion = .false.
  m1_force = .false.
/

&stream_list
  L = 1.d10
  rho = 1.d-17
  Er = 1.d5
  F_red = 1.d0
  Bg_E = 1.d-3
/
