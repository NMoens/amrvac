&filelist
  base_filename='./output/m1_hc'
  autoconvert      = F
  convert_type     = 'vtuBCCmpi'
  saveprim         = F
  nwauxio = 0
/

 &savelist
   itsave(1,1)     = 0
   itsave(1,2)     = 0
   ditsave_log     = 1
/

 &stoplist
   time_max = 1.d-6
   dtmin = 1.0d-20
   !it_max = 1000
/

 &methodlist
   time_stepper = 'onestep'
   time_integrator = 'IMEX_Euler'
   flux_scheme     = 20*'hll'
   limiter         = 20*'koren'
/

&boundlist
  typeboundary_min1 = 5*'periodic'
  typeboundary_max1 = 5*'periodic'
/

 &meshlist
   refine_max_level   = 1
   domain_nx1         = 8
   block_nx1          = 4
   xprobmin1       =  -0.5d0
   xprobmax1       =  0.5d0
 /

 &paramlist
  dtpar = 1.d-11
 /

 &hd_list
  He_abundance = 0.1d0
  hd_energy = .true.
  hd_gamma = 1.666667d0
  hd_m1 = .true.
  m1_opacity_type = 'kappa_e'
  m1_diffusion = .true.
  m1_force = .false.
  m1_RSOL = 1.d-3
 /

 &test_list
  rho0 = 1.d-7
  t0 = 1.d-6
  E_r0 = 1.d12
 /
