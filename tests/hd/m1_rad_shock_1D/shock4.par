&filelist
  base_filename = 'output/shock4_'
  typefilelog   = 'default'
  convert_type  = 'oneblock'
  level_io      = 1
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  dtsave_dat = 10000.d0
  dtsave_log = 10000.d0
  !ditsave_dat = 1
  !ditsave_log = 1
/

&stoplist
  time_max = 200000.d0
  !it_max = 200
/

&methodlist
  time_stepper = 'twostep'
  time_integrator = 'IMEX_Midpoint'
  flux_scheme  = 'hll'
  limiter      = 'weno3'
  fix_small_values = .true.
  small_values_method = 'replace'
  small_pressure = 1.d-6
/

&boundlist
  typeboundary_min1 = 5*'cont'
  typeboundary_max1 = 5*'cont'
/

&meshlist
  refine_max_level   = 1
  refine_criterion   = 3
  domain_nx1         = 600
  block_nx1          = 200
  xprobmin1          = -20.d0
  xprobmax1          = 20.d0
/

&paramlist
  courantpar = 0.3d0
/

&hd_list
  hd_energy       = .true.
  hd_gamma        = 1.667d0
  hd_m1           = .true.
/

&m1_list
  m1_opacity_type = 'kappa_e'
  m1_diffusion    = .false.
  m1_force        = .true.
  m1_RSOL         = 1.d0
/

&shock_list
  rho1    = 1.d0
  p1      = 6.d-3
  v1      = 0.69d0
  Er1     = 0.18d0
  rho2    = 3.65d0
  p2      = 3.59d-2
  v2      = 0.189d0
  Er2     = 1.3d0
/
