&filelist
  base_filename = 'output/shadow1d'
  typefilelog   = 'default'
  convert_type  = 'oneblock'
  autoconvert   = .false.
  level_io      = 1
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  !dtsave_dat = 1d-4
  dtsave_log = 1d-4
  ditsave_dat = 100
  ! ditsave_log = 100
/

&stoplist
  time_max = 1.d-2
  it_max = 5000
/

&methodlist
  time_stepper = 'twostep'
  time_integrator = 'IMEX_Midpoint'
  flux_scheme  = 'tvdlf'
  limiter      = 'minmod'
/

&boundlist
  typeboundary_min1 = 3*'cont','special','special'
  typeboundary_max1 = 5*'noinflow'
/

&meshlist
  refine_max_level   = 1
  refine_criterion   = 3
  domain_nx1         = 256
  block_nx1          = 64
  xprobmin1          = -1.d0
  xprobmax1          = 1.d0
/

&paramlist
  courantpar = 0.2d0
  !slowsteps = 100
/

&hd_list
  He_abundance = 0.d0
  hd_energy  = .true.
  hd_gamma   = 1.667d0
  hd_m1 = .true.
  m1_opacity_type = 'special'
  m1_diffusion = .false.
  m1_force = .true.
  m1_theta_stiff = 0.61d0
/

&stream_list
  L = 1.d0
  rho = 1.d-3
  T_bg = 290.d0
  T_beam = 1740.d0
  rho_clump = 1.d0 !1.d0
/
