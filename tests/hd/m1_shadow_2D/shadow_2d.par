&filelist
  base_filename = 'output/shadow2d'
  typefilelog   = 'default'
  convert_type  = 'vtuBCCmpi'
  autoconvert   = .true.
  level_io      = 1
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  ! dtsave_dat = 1d-2
  dtsave_log = 1d-2
  ditsave_dat = 20
  ! ditsave_log = 100
/

&stoplist
  time_max = 1.d0
  it_max = 5000
/

&methodlist
  time_stepper = 'onestep'
  time_integrator = 'IMEX_Euler'
  flux_scheme  = 'tvdlf'
  limiter      = 'minmod'
/

&boundlist
  typeboundary_min1 = 3*'cont','special','special','cont'
  typeboundary_max1 = 6*'cont'
  typeboundary_min2 = 6*'cont'
  typeboundary_max2 = 6*'cont'
/

&meshlist
  refine_max_level   = 1
  refine_criterion   = 3
  domain_nx1         = 256
  block_nx1          = 16
  domain_nx2         = 128
  block_nx2          = 16
  xprobmin1          = -1.d0
  xprobmax1          = 1.d0
  xprobmin2          = -0.5d0
  xprobmax2          = 0.5d0
/

&paramlist
  courantpar = 0.3d0
  !slowsteps = 100
/

&hd_list
  He_abundance = 0.d0
  hd_energy  = .false.
  hd_gamma   = 1.d0
  hd_m1 = .true.
  m1_opacity_type = 'kappa_e'
  m1_diffusion = .false.
  m1_force = .false.
/

&stream_list
  L = 2.d0
  rho = 2.d0
  T_bg = 290.d0
  T_beam = 1740.d0
  rho_clump = 100.d0
  r_clump = 0.25d0
/
