&filelist
  base_filename = 'output/shock1d'
  typefilelog   = 'default'
  convert_type  = 'oneblock'
  level_io      = 1
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  !dtsave_dat = 1d-2
  !dtsave_log = 1d-2
  ditsave_dat = 1
  ditsave_log = 1
/

&stoplist
  time_max = 1.d0
  !it_max = 200
/

&methodlist
  time_stepper = 'twostep'
  time_integrator = 'IMEX_Midpoint'
  flux_scheme  = 'hll'
  limiter      = 'weno3'
  fix_small_values = .true.
  small_values_method = 'replace'
  small_pressure = 1.d-6
/

&boundlist
  typeboundary_min1 = 5*'special'
  typeboundary_max1 = 5*'special'
/

&meshlist
  refine_max_level   = 1
  refine_criterion   = 3
  domain_nx1         = 256
  block_nx1          = 16
  xprobmin1          = -1.d0
  xprobmax1          = 1.d0
/

&paramlist
  courantpar = 0.3d0
  !slowsteps = 100
/

&hd_list
  He_abundance    = 0.d0
  hd_energy       = .true.
  hd_gamma        = 1.667d0
  hd_m1           = .true.
  m1_opacity_type = 'kappa_e'
  m1_diffusion    = .true.
  m1_force        = .false.
  m1_RSOL         = 1.d0
/

&shock_list
  rho1    = 1.d-2
  rho2    = 3.06495d-2
  v1      = 5.19271d7
  v2      = 1.69422d7
  T1      = 1.08899d6
  T2      = 3.838449d6
/
