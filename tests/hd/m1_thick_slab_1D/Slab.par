&filelist
  base_filename = 'output/Slab_1d'
  typefilelog   = 'default'
  convert_type  = 'oneblock'
  level_io      = 1
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  dtsave_dat = 1.d-3
  dtsave_log = 1.d-2
  ditsave_dat = 1
  ! ditsave_log = 1000
/

&stoplist
  time_max = 1.d-2
  it_max = 10
/

&methodlist
  time_stepper = 'twostep'
  time_integrator = 'IMEX_Midpoint'
  flux_scheme  = 'tvdlf'
  limiter      = 'minmod'
  check_small_values = .True.
  fix_small_values = .True.
  small_values_method = 'replace'
  small_pressure = 1.d-14
/

&boundlist
  typeboundary_min1 = 3*'cont','special','symm'
  typeboundary_max1 = 3*'cont','special','symm'
  internalboundary = .true.
/

&meshlist
  domain_nx1         = 200
  block_nx1          = 100
  xprobmin1          = 1.0d0
  xprobmax1          = 1.01d0
  stretch_dim(1)     = 'uni'
  !qstretch_baselevel = 1.015
/

&paramlist
  courantpar = 0.4d0
/

&hd_list
  hd_gravity = .false.
  hd_energy  = .true.
  hd_gamma   = 1.667d0
  hd_m1 = .true.
  m1_opacity_type = 'kappa_e'
  m1_heatcool = .false.
  m1_force = .false.
  m1_RSOL = 1.d0
  m1_theta_stiff = 1.d0
  m1_well_balanced = .false.
/

&star_list
  mstar    = 21.0d0
  rstar    = 11.0d0
  Tbound   = 5.0d5
  gamma_e  = 0.17d0
  rhobound = 3.8d-6
/
