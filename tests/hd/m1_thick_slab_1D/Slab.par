&filelist
  base_filename = 'output/Slab_1d'
  typefilelog   = 'default'
  convert_type  = 'oneblock'
  level_io      = 1
  saveprim      = .true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  dtsave_dat = 1.d0
  ! dtsave_log = 1.d-2
  ! ditsave_dat = 100
  ! ditsave_log = 1000
/

&stoplist
  time_max = 1.d1
  !it_max = 1000
/

&methodlist
  time_stepper = 'onestep'
  time_integrator = 'IMEX_Euler'
  flux_scheme  = 'hll'
  limiter      = 'minmod'
  gradient_limiter = 'minmod'
  check_small_values = .false.
  fix_small_values = .false.
  small_values_method = 'replace'
  small_pressure = 1.d-14
/

&boundlist
  typeboundary_min1 = 2*'cont','special','special'
  typeboundary_max1 =  2*'cont','special','special'
  internalboundary = .false.
/

&meshlist
  domain_nx1         = 300
  block_nx1          = 100
  xprobmin1          = -1.d0
  xprobmax1          = 1.d0
/

&paramlist
  courantpar = 0.4d0
/

&hd_list
  hd_gravity = .false.
  hd_energy  = .false.
  hd_gamma   = 1.667d0
  hd_m1 = .true.
/

&m1_list
  m1_opacity_type = 'special'
  m1_heatcool = .false.
  m1_force = .false.
  m1_RSOL = 1.d0
/

&star_list
  rho = 1.d6
  Fbound = 1.d0
  kappa_step = 0.5d0 !1.d-2 !1.d-5
/
